{
  "rewrites": [
    { "source": "/proxy/generate-params", "destination": "/api/generate-params" },
    { "source": "/proxy/chat",            "destination": "/api/chat" },
    { "source": "/proxy/surveys",         "destination": "/api/surveys" }
  ],
  "headers": [
    {
      "source": "/(.*\\.html|.*\\.js|.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" }
      ]
    }
  ]
}
